# App
APP_NAME=TeamFlow API
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=teamflow

# Account security (replace with a long random value)
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Resend email verification
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=TeamFlow <verify@your-domain.example>

# Hosted NVIDIA NIM chat completions
NIM_API_KEY=nvapi-xxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=<model-id-enabled-for-your-account>

# Optional providers; used only when selected explicitly
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# WebRTC STUN/TURN configuration (TURN recommended for production)
ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]
