# App
APP_NAME=TeamFlow API
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=teamflow

# Account security (replace with a long random value)
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_CODE_MINUTES=10
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Resend email verification
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=TeamFlow <verify@your-domain.example>

# Conversation summaries try NVIDIA NIM first, then Gemini, then Ollama.
# Hosted NVIDIA NIM chat completions
NIM_API_KEY=nvapi-xxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=<model-id-enabled-for-your-account>
AI_REQUEST_TIMEOUT_SECONDS=25
SENTIMENT_MODEL_PATH=

# Optional summary fallbacks; a provider needs its model (and key where applicable).
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Cloudflare Realtime managed TURN
# Create a TURN key in Cloudflare; use its result.uid and result.key here.
# Keep the key token on the backend. The app issues short-lived ICE credentials to signed-in callers.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_TOKEN=
CLOUDFLARE_TURN_CREDENTIAL_TTL=86400

# Optional STUN-only fallback used when Cloudflare TURN credentials are not configured.
# TURN is needed for calls on restrictive networks.
ICE_SERVERS_JSON=[{"urls":["stun:stun.cloudflare.com:3478"]}]
